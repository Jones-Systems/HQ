{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
