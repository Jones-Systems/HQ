  "queries": {
    "Q1": "SELECT 'm' AS k, hex(name) AS n, int_value AS i, hex(str_value) AS s, str_value IS NULL AS z FROM metadata\nUNION ALL\nSELECT 's', hex(name), value, hex(coalesce(severity,'')||'|'||coalesce(source,'')||'|'||coalesce(idx,'')), 0 FROM stats WHERE value <> 0",
    "Q2": "SELECT 'e' AS k, s.id AS sid, s.ts AS ts, coalesce(p1.pid, p2.pid) AS pid, '' AS ak, '' AS vt, NULL AS i, NULL AS r, '' AS sv, 0 AS z\nFROM slice s\nLEFT JOIN thread_track tt ON s.track_id = tt.id LEFT JOIN thread t ON tt.utid = t.utid LEFT JOIN process p1 ON t.upid = p1.upid\nLEFT JOIN process_track pt ON s.track_id = pt.id LEFT JOIN process p2 ON pt.upid = p2.upid\nWHERE s.name = 'LayerTreeHostImpl:snapshot'\nUNION ALL\nSELECT 'a', s.id, NULL, NULL, hex(a.key), hex(a.value_type), a.int_value,\n  CASE WHEN a.real_value IS NULL THEN NULL ELSE printf('%.17g', a.real_value) END,\n  hex(a.string_value), a.string_value IS NULL\nFROM slice s JOIN args a ON a.arg_set_id = s.arg_set_id\nWHERE s.name = 'LayerTreeHostImpl:snapshot'\n  AND (a.key = 'debug.snapshot' OR a.key = 'debug.snapshot.active_tree.layers'\n       OR substr(a.key, 1, 34) = 'debug.snapshot.active_tree.layers[')"
  },
